.fade-in-up {
;
}

.float-active {
;
}

.glass-card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.05);
  box-sizing: border-box;
}

.gradient-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 50rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(102, 126, 234, 0.3);
}

.gradient-btn-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
  opacity: 0.95;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.08);
  border: 1rpx solid rgba(224, 229, 242, 0.8);
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: 30rpx;
}

