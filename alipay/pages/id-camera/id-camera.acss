.camera-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #111111;
}

.camera-view {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 190rpx;
  left: 0;
  width: 100%;
  height: auto;
}

.camera-copy {
  position: absolute;
  z-index: 5;
  top: 34rpx;
  right: 24rpx;
  left: 24rpx;
  color: #ffffff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.85);
}

.camera-init-hint {
  position: absolute;
  z-index: 8;
  top: 148rpx;
  right: 36rpx;
  left: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  text-shadow: 0 2rpx 7rpx rgba(0, 0, 0, 0.8);
}

.camera-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.camera-subtitle {
  margin-top: 4rpx;
  font-size: 25rpx;
  line-height: 38rpx;
}

.portrait-guide {
  position: absolute;
  z-index: 4;
  opacity: 0.98;
}

.eye-label {
  position: absolute;
  z-index: 5;
  right: 0;
  left: 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  text-align: center;
  text-shadow: 0 2rpx 7rpx rgba(0, 0, 0, 0.8);
}

.camera-controls {
  position: absolute;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  height: 190rpx;
  padding: 18rpx 54rpx 18rpx 54rpx;
  background: rgba(9, 10, 12, 0.96);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.control-side {
  flex: 1;
  height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.control-icon {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  font-size: 38rpx;
  line-height: 52rpx;
  text-align: center;
}

.album-icon {
  font-size: 30rpx;
}

.control-label {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.shutter-outer {
  width: 146rpx;
  height: 146rpx;
  margin: 0 auto;
  border: 7rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shutter-inner {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #ffffff;
}

.shutter-active {
  transform: scale(0.92);
  opacity: 0.68;
}

.shutter-disabled {
  opacity: 0.4;
}

.confirm-view {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.captured-preview {
  width: 100%;
  flex: 1;
  min-height: 0;
  background: #111111;
}

.confirm-caption {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #273047;
  font-size: 27rpx;
}

.confirm-actions {
  display: flex;
  padding: 18rpx 24rpx 18rpx;
  border-top: 2rpx solid #edf0f5;
  background: #ffffff;
}

.confirm-button {
  height: 88rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
}

.retake-button {
  border: 2rpx solid #2f7df6;
  color: #2f7df6;
}

.use-button {
  background: #2f7df6;
  color: #ffffff;
}

.camera-error-view {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 80rpx 56rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #15171b;
  color: #ffffff;
}

.error-symbol {
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 28rpx;
  border: 4rpx solid #f6b51b;
  border-radius: 50%;
  color: #f6b51b;
  font-size: 48rpx;
  line-height: 80rpx;
  text-align: center;
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
}

.error-text {
  margin: 18rpx 0 42rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.error-button {
  width: 100%;
  height: 88rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.primary-error-button {
  background: #2f7df6;
}

.secondary-error-button {
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  color: #ffffff;
}


/* Alipay layout compatibility: WX grid/gap fallback */
.confirm-actions {
  display: flex;
  justify-content: space-between;
}
.confirm-btn {
  width: 48.5%;
  flex-shrink: 0;
}
