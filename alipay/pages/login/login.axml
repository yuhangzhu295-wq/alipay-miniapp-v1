<view class="page">
  <view class="login-card">
    <view class="avatar-wrap">
      <button class="avatar-button" onTap="chooseAvatar">
        <image a:if="{{userInfo && userInfo.avatarUrl}}" class="avatar-image" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text a:else class="avatar-placeholder">👤</text>
      </button>
    </view>
    <input class="nickname-input" type="nickname" placeholder="填写微信昵称" value="{{userInfo && userInfo.nickName ? userInfo.nickName : ''}}" onInput="onNicknameInput" />
    <button class="login-button" loading="{{saving}}" disabled="{{saving}}" onTap="saveProfile">完成授权</button>
  </view>
</view>
