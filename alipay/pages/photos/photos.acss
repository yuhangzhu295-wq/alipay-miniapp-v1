.page {
  padding: 36rpx 30rpx 140rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.reminder-banner {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #fffbf0 0%, #fff7e6 100%);
  border: 1rpx solid rgba(255, 152, 0, 0.15);
  border-radius: 32rpx;
  padding: 24rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 50rpx;
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.05);
}

.reminder-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff9800, #f57c00);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(255, 152, 0, 0.25);
}

.reminder-icon {
  font-size: 26rpx;
  color: #ffffff;
}

.reminder-text {
  font-size: 24rpx;
  color: #e65100;
  line-height: 1.6;
  flex: 1;
  font-weight: 500;
}

.photo-list {
  width: 100%;
}

.photo-loading {
  width: 100%;
  padding: 36rpx 0;
  text-align: center;
  color: #7e7e9a;
  font-size: 26rpx;
}

.photo-card {
  background: #ffffff;
  border: 1rpx solid rgba(224, 229, 242, 0.8);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.05);
  overflow: hidden;
  width: 100%;
}

.photo-card-top {
  display: flex;
  padding: 24rpx;
}

.card-thumb {
  width: 130rpx;
  height: 170rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f4f6fc;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.card-size {
  font-size: 24rpx;
  color: #7e7e9a;
  font-weight: 500;
}

.card-time {
  font-size: 22rpx;
  color: #b5b5c9;
  font-weight: 400;
}

.photo-card-actions {
  display: flex;
  border-top: 1rpx solid rgba(224, 229, 242, 0.8);
  background: #fcfdfe;
}

.card-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
  font-weight: 700;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 50rpx;
}

.empty-illustration {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 48rpx;
  box-shadow: 0 16rpx 40rpx rgba(102, 126, 234, 0.12);
  border: 8rpx solid #ffffff;
}

.empty-icon {
  font-size: 110rpx;
}

.empty-icon-deco {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  font-size: 40rpx;
}

.empty-icon-deco2 {
  position: absolute;
  bottom: 50rpx;
  right: 30rpx;
  font-size: 36rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7e7e9a;
  text-align: center;
  line-height: 1.6;
  font-weight: 500;
}

.action-area {
  width: 100%;
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
}

.btn-primary {
  width: 520rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(102, 126, 234, 0.3);
}

.btn-camera-icon {
  font-size: 38rpx;
}

.btn-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
}

