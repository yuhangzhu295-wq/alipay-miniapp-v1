<!-- ========== 个人中心（效果图6）========== -->
<view class="page">

  <!-- Profile Card -->
  <view class="profile-card" onTap="handleUserCardTap">
    <view class="profile-avatar">
      <image a:if="{{userInfo && userInfo.avatarUrl}}" class="avatar-image" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <text a:else class="avatar-placeholder">👤</text>
    </view>
    <text class="profile-greeting">{{greetingText}}</text>
    <text class="profile-welcome">{{welcomeText}}</text>
    <view class="profile-settings">
      <text class="settings-icon">⚙️</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-card">
    <view class="menu-item" onTap="goOrders">
      <view class="menu-item-left">
        <view class="menu-icon-wrap" style="background-color: #e3f2fd;">
          <text class="menu-icon">📋</text>
        </view>
        <text class="menu-label">我的订单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-item" onTap="goFAQ">
      <view class="menu-item-left">
        <view class="menu-icon-wrap" style="background-color: #fce4ec;">
          <text class="menu-icon">❓</text>
        </view>
        <text class="menu-label">常见问题</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-item" onTap="goGuide">
      <view class="menu-item-left">
        <view class="menu-icon-wrap" style="background-color: #e8f5e9;">
          <text class="menu-icon">📖</text>
        </view>
        <text class="menu-label">拍摄攻略</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-item" onTap="contactService">
      <view class="menu-item-left">
        <view class="menu-icon-wrap" style="background-color: #fff3e0;">
          <text class="menu-icon">🎧</text>
        </view>
        <text class="menu-label">联系客服</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-divider"></view>

    <button class="menu-item menu-share-button" open-type="share">
      <view class="menu-item-left">
        <view class="menu-icon-wrap" style="background-color: #f3e5f5;">
          <text class="menu-icon">📤</text>
        </view>
        <text class="menu-label">分享小程序</text>
      </view>
      <text class="menu-arrow">›</text>
    </button>
  </view>

  <!-- 添加到小程序卡片 -->
  <view class="add-card" onTap="addToMiniProgram">
    <view class="add-card-left">
      <view class="add-icon-wrap">
        <text class="add-icon">⭐</text>
      </view>
      <view class="add-info">
        <text class="add-title">添加到我的小程序</text>
        <text class="add-desc">点击右上角"..."添加，下次使用更方便</text>
      </view>
    </view>
    <view class="add-btn">
      <text class="add-btn-text">去添加</text>
      <text class="add-btn-arrow">›</text>
    </view>
  </view>

</view>
