.page {
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
  padding: 24rpx 24rpx 140rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 100%);
}

.spec-toolbar {
  display: flex;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.spec-search {
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.spec-search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.spec-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  height: 72rpx;
}

.spec-filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 72rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.filter-icon {
  font-size: 24rpx;
}

.filter-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

.spec-page-head {
  margin: 4rpx 0 22rpx;
}

.spec-page-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.spec-page-desc {
  font-size: 23rpx;
  color: #7a8194;
  line-height: 1.5;
}

.spec-page-notice {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a6a00;
  line-height: 1.45;
}

.spec-grid {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.spec-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 16rpx;
  display: flex;
  align-items: stretch;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  position: relative;
  min-width: 0;
  min-height: 174rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.spec-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #ffffff;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 20rpx 0 16rpx;
  font-weight: 600;
}

.spec-card-left {
  width: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spec-thumb {
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spec-thumb-icon {
  font-size: 36rpx;
}

.spec-card-right {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  justify-content: center;
  overflow: hidden;
}

.spec-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  line-height: 1.25;
}

.spec-card-size {
  font-size: 21rpx;
  color: #999;
  overflow: hidden;
  line-height: 1.25;
  max-width: 100%;
}

.spec-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-width: 0;
}

.spec-file-text {
  font-size: 18rpx;
  color: #667085;
  background: #f2f4f7;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-badge {
  font-size: 18rpx;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}

.source-official,
.source-official_notice {
  color: #166534;
  background: #dcfce7;
}

.source-platform_rule {
  color: #1d4ed8;
  background: #dbeafe;
}

.source-platform {
  color: #1d4ed8;
  background: #dbeafe;
}

.source-local_common {
  color: #0f766e;
  background: #ccfbf1;
}

.source-deprecated {
  color: #92400e;
  background: #fef3c7;
}

.source-unknown {
  color: #475569;
  background: #f1f5f9;
}

.source-custom {
  color: #5b21b6;
  background: #ede9fe;
}

.source-third_party_pending {
  color: #92400e;
  background: #fef3c7;
}

.source-user_custom {
  color: #5b21b6;
  background: #ede9fe;
}

.spec-card-apply {
  font-size: 20rpx;
  color: #667085;
  line-height: 1.35;
  overflow: hidden;
}

.spec-card-note {
  font-size: 19rpx;
  color: #9a6a00;
  line-height: 1.35;
  overflow: hidden;
}

.spec-colors {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 4rpx;
  min-height: 22rpx;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.show-more {
  margin: 28rpx auto 0;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ffffff;
  color: #667eea;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.empty-state {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}


/* Alipay layout compatibility: WX grid/gap fallback */
.search-row {
  display: flex;
  align-items: center;
}
.search-input-wrap {
  flex: 1;
}
.custom-btn {
  width: 112rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.spec-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.spec-card {
  width: 48.6%;
  flex-shrink: 0;
  margin-bottom: 18rpx;
}
