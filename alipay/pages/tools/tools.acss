.page {
  padding: 36rpx 30rpx 140rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tool-grid {
  display: flex;
}

.tool-card {
  background: #ffffff;
  border: 1rpx solid rgba(224, 229, 242, 0.8);
  border-radius: 32rpx;
  padding: 32rpx 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.05);
}

.tool-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tool-icon {
  font-size: 52rpx;
}

.tool-badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  color: #ffffff;
  font-size: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.4);
  z-index: 10;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
}

.tool-desc {
  font-size: 22rpx;
  color: #7e7e9a;
  text-align: center;
  font-weight: 500;
  line-height: 1.4;
  padding: 0 8rpx;
}

.float-share {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 110rpx;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(102, 126, 234, 0.25);
  z-index: 999;
}

.share-icon {
  font-size: 34rpx;
}

.share-label {
  font-size: 18rpx;
  color: #667eea;
  font-weight: 700;
}


/* Alipay layout compatibility: WX grid/gap fallback */
.tools-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.tool-card {
  width: 48%;
  flex-shrink: 0;
  margin-bottom: 24rpx;
}
