# Copy to a server-only EnvironmentFile such as
# /etc/photo-generator/alipay-staging.env. Never commit the copied file.
#
# This isolated service serves only the /alipay-staging-v1/ Nginx prefix.
# Values are intentionally blank: provide them through the server secret store.

PORT=18001
ID_PHOTO_RUNTIME_DIR=/var/lib/photo-generator/alipay-staging
ID_PHOTO_AUTH_SECRET=
IOPAINT_URL=http://127.0.0.1:8081
# This existing server keeps its production Python dependencies in this
# read-only location. The isolated Staging service gets no production secrets.
ALIPAY_STAGING_PYTHON=/root/photo-generator/server/.venv/bin/python3

# Alipay Mini Program server-side authorization.
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_AUTH_TIMEOUT_SECONDS=10

# Alibaba Cloud Green image moderation. Both values are required and remain
# exclusively on the staging server.
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION_ID=cn-shanghai
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_GREEN_IMAGE_SERVICE=baselineCheck

# Public HTTPS paths used by the staging content-safety provider. The Nginx
# location must strip this prefix before proxying to the local service.
ALIPAY_STAGING_BASE_URL=https://tupzjianzhao.chat/alipay-staging-v1
CONTENT_SECURITY_PUBLIC_BASE_URL=https://tupzjianzhao.chat/alipay-staging-v1
