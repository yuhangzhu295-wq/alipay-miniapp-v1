.page {
  min-height: 100vh;
  padding: 56rpx 32rpx;
  background: #f4f6fc;
  box-sizing: border-box;
}

.login-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 12rpx 34rpx rgba(102, 126, 234, 0.12);
}

.avatar-wrap {
  width: 144rpx;
  height: 144rpx;
}

.avatar-button {
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #eef2ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-button::after {
  border: 0;
}

.avatar-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 64rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-button {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.login-button::after {
  border: 0;
}
