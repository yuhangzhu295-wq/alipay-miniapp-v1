<!-- ========== 首页 ========== -->
<view class="page">
  <view class="search-row search-bar">
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">⌕</text>
      <text class="search-placeholder">搜索规格名称、尺寸或用途</text>
    </view>
    <view class="custom-size-btn" bindtap="goCustomSize">
      <text class="custom-size-icon">□</text>
      <text class="custom-size-text">自定义</text>
    </view>
  </view>

  <view class="section-header core-header">
    <view class="section-title-left">
      <view class="section-dot section-dot-core"></view>
      <text class="section-title-text">核心功能</text>
    </view>
  </view>

  <view class="core-grid">
    <view
      wx:for="{{coreFeatures}}"
      wx:key="id"
      class="core-card {{item.className}} {{index === 2 ? 'core-card-wide' : ''}}"
      bindtap="goCoreFeature"
      data-route="{{item.route}}"
    >
      <view class="core-copy">
        <text class="core-title">{{item.title}}</text>
        <text class="core-desc">{{item.desc}}</text>
      </view>
      <view class="core-visual">
        <view class="core-visual-inner {{item.icon}}"></view>
      </view>
    </view>
  </view>

  <view class="panel hot-panel">
    <view class="section-header">
      <view class="section-title-left">
        <text class="section-mark">热</text>
        <text class="section-title-text">热门证件照</text>
      </view>
      <view class="section-more" bindtap="goSpecs">
        <text class="more-text">更多规格</text>
        <text class="more-arrow">›</text>
      </view>
    </view>

    <scroll-view class="hot-scroll" scroll-x enable-flex>
      <view
        wx:for="{{hotSpecs}}"
        wx:key="id"
        class="hot-card"
        bindtap="selectHotSpec"
        data-id="{{item.id}}"
      >
        <view class="hot-thumb" style="background-color: {{item.thumbBg}};">
          <view class="hot-thumb-icon {{item.icon}}"></view>
        </view>
        <text class="hot-name">{{item.name}}</text>
        <text class="hot-size">{{item.size}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="panel tools-panel">
    <view class="section-header">
      <view class="section-title-left">
        <view class="section-dot section-dot-tools"></view>
        <text class="section-title-text">更多工具</text>
      </view>
    </view>

    <view class="tools-grid">
      <view
        wx:for="{{moreTools}}"
        wx:key="id"
        class="tool-card"
        bindtap="goTool"
        data-route="{{item.route}}"
      >
        <view class="tool-icon {{item.icon}}"></view>
        <text class="tool-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
