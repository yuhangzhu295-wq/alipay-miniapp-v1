/* ====== 选择底色 / 下载证件照 ====== */

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(180rpx + env(safe-area-inset-bottom, 20rpx));
  background: #f4f6fb;
  box-sizing: border-box;
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}

.top-tabs {
  height: 76rpx;
  padding: 6rpx;
  background: #ffffff;
  border-radius: 38rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(26, 26, 46, 0.06);
}

.tab-item {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #667085;
  font-weight: 700;
}

.tab-active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
}

.preview-card,
.config-card,
.action-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(26, 26, 46, 0.06);
}

.preview-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.preview-title {
  display: block;
  font-size: 32rpx;
  color: #1a1a2e;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.preview-subtitle {
  display: block;
  font-size: 23rpx;
  color: #667085;
}

.preview-file {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #667085;
}

.change-spec {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #eef2ff;
  color: #667eea;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.photo-measure {
  position: relative;
  width: 520rpx;
  margin: 0 auto;
  padding: 42rpx 48rpx 46rpx 54rpx;
  box-sizing: border-box;
}

.photo-bg {
  border-radius: 0;
  border: 0;
  overflow: hidden;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  background-clip: padding-box;
}

.photo-bg-failed {
  border-color: #e5e7eb;
  box-shadow: none;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.layout-img {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: rgba(255,255,255,0.92);
}

.photo-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.18);
}

.photo-loading-text {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 46, 0.52);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.placeholder-icon {
  font-size: 60rpx;
}

.placeholder-text {
  font-size: 25rpx;
  font-weight: 700;
}

.measure-top,
.measure-bottom,
.measure-left,
.measure-right {
  position: absolute;
  font-size: 22rpx;
  color: #667085;
  font-weight: 700;
}

.measure-top {
  top: 0;
  left: 0;
  right: 0;
  text-align: center;
}

.measure-bottom {
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
}

.measure-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%) rotate(-90deg);
}

.measure-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
}

.status-line {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #667eea;
  font-weight: 700;
}

.detail-status {
  width: fit-content;
  margin: 12rpx auto 0;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 700;
}

.failure-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #f0c36a;
  border-radius: 8rpx;
  background: #fffaf0;
}

.failure-title,
.failure-copy {
  display: block;
}

.failure-title {
  color: #7a4b00;
  font-size: 28rpx;
  font-weight: 800;
}

.failure-copy {
  margin-top: 10rpx;
  color: #694d23;
  font-size: 24rpx;
  line-height: 1.6;
}

.failure-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.failure-button {
  min-height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.failure-secondary {
  border: 2rpx solid #1a73e8;
  color: #1a73e8;
  background: #ffffff;
}

.failure-primary {
  color: #ffffff;
  background: #1a73e8;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.color-item {
  min-height: 92rpx;
  border-radius: 20rpx;
  background: #f7f8fc;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #475467;
  font-weight: 700;
}

.color-active {
  border-color: #667eea;
  background: #eef2ff;
  color: #4f46e5;
}

.color-swatch {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.btn-secondary,
.btn-primary {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.btn-secondary {
  background: #f2f4f7;
  color: #344054;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(102, 126, 234, 0.28);
}

.btn-disabled {
  opacity: 0.55;
}
