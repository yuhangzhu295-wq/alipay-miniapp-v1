<!-- ========== 搜索证件照规格 ========== -->
<view class="page">

  <view class="spec-toolbar">
    <view class="spec-search">
      <text class="spec-search-icon">🔍</text>
      <input class="spec-search-input" value="{{searchValue}}" placeholder="搜索规格名称、尺寸或用途" bindinput="onSearch" />
    </view>
    <view class="spec-filter-btn" bindtap="toggleFilter">
      <text class="filter-icon">🗂️</text>
      <text class="filter-text">筛选</text>
    </view>
  </view>

  <view class="spec-page-head">
    <text class="spec-page-title">{{pageMode === 'group' ? currentGroupName : (pageMode === 'search' ? '搜索结果' : '常用规格')}}</text>
    <text class="spec-page-desc" wx:if="{{pageMode === 'home'}}">常用入口优先展示，多尺寸规格点击后再选择具体尺寸</text>
    <text class="spec-page-desc" wx:if="{{pageMode === 'group'}}">选择一个具体尺寸后进入底色与下载页面</text>
    <text class="spec-page-desc" wx:if="{{pageMode === 'search'}}">优先展示高相关规格，重复尺寸已合并</text>
    <text class="spec-page-notice">规格可能随地区和报名平台调整，请以当年官方公告为准。</text>
  </view>

  <view class="spec-grid">
    <view
      wx:for="{{filteredSpecs}}"
      wx:key="id"
      class="spec-card"
      bindtap="selectSpec"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
      data-group="{{item.groupId}}"
      data-spec="{{item.specId}}"
    >
      <view class="spec-card-left">
        <view class="spec-thumb" style="background-color: {{item.thumbBg}};">
          <text class="spec-thumb-icon">{{item.icon}}</text>
        </view>
      </view>
      <view class="spec-card-right">
        <text class="spec-card-name">{{item.name}}</text>
        <text class="spec-card-size">{{item.size}}</text>
        <view wx:if="{{item.sourceBadge || item.fileText}}" class="spec-meta-row">
          <text wx:if="{{item.fileText}}" class="spec-file-text">{{item.fileText}}</text>
          <text wx:if="{{item.sourceBadge}}" class="source-badge {{item.sourceClass}}">{{item.sourceBadge}}</text>
        </view>
        <text wx:if="{{item.applicableText}}" class="spec-card-apply">{{item.applicableText}}</text>
        <view class="spec-colors">
          <view
            wx:for="{{item.colors}}"
            wx:key="id"
            class="color-dot"
            style="background-color: {{item.hex}}; {{item.id === 'white' ? 'border: 2rpx solid #ddd;' : ''}}"
          ></view>
        </view>
      </view>
      <view wx:if="{{item.badge}}" class="spec-badge">{{item.badge}}</view>
    </view>
  </view>

  <view wx:if="{{pageMode === 'search' && hiddenSearchCount > 0}}" class="show-more" bindtap="showMoreSearch">
    查看更多 {{hiddenSearchCount}} 个结果
  </view>

  <view wx:if="{{filteredSpecs.length === 0}}" class="empty-state">
    <text>未找到相关规格</text>
  </view>
</view>
