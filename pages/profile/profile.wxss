/* ====== 个人中心样式 ====== */

.page {
  padding: 36rpx 30rpx calc(140rpx + env(safe-area-inset-bottom, 20rpx));
  min-height: 100vh;
  background: radial-gradient(circle at 0% 100%, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.05) 50%, #f4f6fc 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 3D 悬浮渐变个人卡片 */
.profile-card {
  position: relative;
  background: var(--gradient-main);
  border-radius: 36rpx;
  padding: 64rpx 0 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(102, 126, 234, 0.25);
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
}

.profile-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}

.profile-avatar {
  width: 130rpx;
  height: 130rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  box-shadow: 0 8rpx 20rpx rgba(26, 26, 46, 0.15);
  animation: floatAnim 3s ease-in-out infinite;
}

.avatar-placeholder { 
  font-size: 64rpx; 
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.profile-greeting { 
  font-size: 36rpx; 
  font-weight: 800; 
  color: #ffffff; 
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.15);
}

.profile-welcome { 
  font-size: 24rpx; 
  color: rgba(255, 255, 255, 0.8); 
  font-weight: 500;
  z-index: 1;
}

.profile-settings {
  position: absolute;
  top: 30rpx;
  right: 36rpx;
  z-index: 2;
  transition: all 0.3s ease;
}

.profile-settings:active {
  transform: rotate(45deg) scale(0.9);
}

.settings-icon { font-size: 38rpx; color: rgba(255, 255, 255, 0.7); }

/* iOS风精致菜单列表重构 */
.menu-card {
  background: #ffffff;
  border: 1rpx solid var(--border-light);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  transition: all 0.3s ease;
}

.menu-share-button {
  width: 100%;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  text-align: left;
  box-sizing: border-box;
}

.menu-share-button::after {
  border: 0;
}

.menu-item:active {
  background-color: var(--primary-light);
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.08);
}

.menu-icon { font-size: 32rpx; }
.menu-label { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.menu-arrow { font-size: 32rpx; color: var(--text-light); font-weight: 700; }

.menu-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 0 36rpx;
}

/* 渐变装饰提醒卡片 */
.add-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fffcf0 0%, #fff7e6 100%);
  border: 1rpx solid rgba(255, 152, 0, 0.15);
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  transition: all 0.3s ease;
}

.add-card:active {
  transform: scale(0.98);
}

.add-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.add-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #ff9800, #f57c00);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.add-icon { font-size: 36rpx; color: #ffffff; }

.add-info { display: flex; flex-direction: column; gap: 6rpx; }
.add-title { font-size: 26rpx; font-weight: 700; color: #e65100; }
.add-desc { font-size: 22rpx; color: #b7813a; line-height: 1.4; font-weight: 500; }

.add-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(255, 152, 0, 0.1);
  transition: all 0.3s ease;
}

.add-btn:active {
  background: #fffcf0;
  transform: translateY(2rpx);
}

.add-btn-text { font-size: 22rpx; color: #ff9800; font-weight: 700; }
.add-btn-arrow { font-size: 22rpx; color: #ff9800; font-weight: 700; }
